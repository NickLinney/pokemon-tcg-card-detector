{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-artifact-index-v1",
  "type": "object",
  "required": ["schema_version", "artifact_index_id", "run_id", "state", "artifacts", "sealed_at"],
  "properties": {
    "schema_version": {"const": "run-artifact-index-v1"},
    "artifact_index_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "run_id": {"type": "string", "pattern": "^run-[A-Za-z0-9-]{1,120}$"},
    "state": {"const": "SEALED"},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "sealed_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
