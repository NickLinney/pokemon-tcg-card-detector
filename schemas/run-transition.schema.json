{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-transition-v1",
  "type": "object",
  "required": ["schema_version", "transition_id", "run_id", "manifest_id", "sequence", "from_state", "to_state", "reason", "evidence_refs", "occurred_at"],
  "properties": {
    "schema_version": {"const": "run-transition-v1"},
    "transition_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "run_id": {"type": "string"},
    "manifest_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "from_state": {"type": ["string", "null"]},
    "to_state": {"type": "string"},
    "reason": {"type": "string"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "occurred_at": {"type": "string"}
  },
  "additionalProperties": false
}
