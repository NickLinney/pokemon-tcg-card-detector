{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "superseding-assertion-v1",
  "type": "object",
  "required": ["schema_version", "assertion_id", "location_id", "source_disposition_id", "supersedes", "effective_state", "created_at"],
  "properties": {
    "schema_version": {"const": "superseding-assertion-v1"},
    "assertion_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "location_id": {"type": "string", "minLength": 1},
    "source_disposition_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "supersedes": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "effective_state": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
