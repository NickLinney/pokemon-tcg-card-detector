{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-job-v1",
  "type": "object",
  "required": ["schema_version", "job_id", "state", "context", "source_sha256", "idempotency_key_sha256", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "analysis-job-v1"},
    "job_id": {"type": "string", "pattern": "^job-[0-9a-f]{32}$"},
    "state": {"enum": ["REQUESTED", "ADMITTED", "RUNNING", "CANCEL_REQUESTED", "SUCCEEDED", "FAILED", "CANCELED", "REJECTED", "RECOVERY_REQUIRED"]},
    "context": {"type": "object"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": ["string", "null"]},
    "error": {"type": ["object", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
