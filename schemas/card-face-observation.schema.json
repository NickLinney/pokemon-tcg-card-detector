{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card-face-observation-v2",
  "type": "object",
  "required": ["pocket_index", "source_polygon", "normalized_crop_artifact", "quality", "template_classification", "template_predictions", "localization_template_id", "localization_template_is_fact"],
  "properties": {
    "pocket_index": {"type": "integer", "minimum": 1},
    "source_polygon": {"type": "array", "minItems": 4, "maxItems": 4},
    "normalized_crop_artifact": {"type": "object"},
    "quality": {"type": "object"},
    "template_classification": {"type": "object"},
    "template_predictions": {"type": "array"},
    "localization_template_id": {"type": "string"},
    "localization_template_is_fact": {"const": false}
  },
  "additionalProperties": true
}
