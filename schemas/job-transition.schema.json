{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-transition-v1",
  "type": "object",
  "required": ["schema_version", "transition_id", "job_id", "sequence", "from_state", "to_state", "reason", "occurred_at"],
  "properties": {
    "schema_version": {"const": "job-transition-v1"},
    "transition_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "job_id": {"type": "string", "pattern": "^job-[0-9a-f]{32}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "from_state": {"type": ["string", "null"]},
    "to_state": {"type": "string"},
    "reason": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
